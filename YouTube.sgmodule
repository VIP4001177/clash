#!name=YouTube去广告
#!desc=2026
#!author=DivineEngine + app2smile + Maasea + ddgksf2013 + Aioneas
#!homepage=https://github.com/Aioneas/Surge
#!icon=https://raw.githubusercontent.com/Aioneas/Surge/main/Icon/YouTube.png
#!category=Aioneas

[URL Rewrite]
# ======= 视频广告请求 =======
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Script]
# ======= 稳定去广告 + 尝试隐藏 Shorts 相关 UI =======
youtube.response = type=http-response, pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch), script-path=https://raw.githubusercontent.com/Aioneas/Surge/main/Script/youtube.response.js, argument="{\"lyricLang\":\"off\",\"captionLang\":\"off\",\"blockUpload\":true,\"blockImmersive\":false,\"blockShorts\":true,\"debug\":false}", requires-body=true, binary-body-mode=true, timeout=60

[Map Local]
# ======= 视频/通用广告请求本地 Mock =======
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad data=" " status-code=200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads data=" " status-code=200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) data=" " status-code=200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext data=" " status-code=200

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, www.youtube.com, s.youtube.com, youtubei.googleapis.com

[Rule]
# 拦截 QUIC 协议，迫使 YouTube 降级到 TCP，从而完美去广告
REJECT,DEST-PORT=443,PROTOCOL=UDP