DOMAIN-KEYWORD,core-c-lq,PROXY
DOMAIN-KEYWORD,normal-lq,PROXY
DOMAIN-KEYWORD,normal-c-lq,PROXY

#新版抖音评论提交接口（解决发评论不伪装）
DOMAIN-KEYWORD,comment-submit,PROXY
DOMAIN-KEYWORD,comment-publish,PROXY
DOMAIN-KEYWORD,reply-submit,PROXY
DOMAIN-KEYWORD,comment-sync,PROXY
