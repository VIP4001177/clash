#!name=抖音IP归属地
#!desc=社交软件

[Rule]
#视频直连
DOMAIN-SUFFIX,douyinvod.com,DIRECT
DOMAIN-SUFFIX,douyincdn.com,DIRECT
DOMAIN-SUFFIX,douyinpic.com,DIRECT

#直播直连
DOMAIN,live.douyin.com,DIRECT
DOMAIN,webcast.amemv.com,DIRECT
DOMAIN-KEYWORD,douyin-live,DIRECT
DOMAIN-KEYWORD,live-douyin,DIRECT
DOMAIN-KEYWORD,webcast,DIRECT

#发评论代理、发作品代理
DOMAIN-SUFFIX,snssdk.com,PROXY
DOMAIN-SUFFIX,toutiaoapi.com,PROXY
DOMAIN-SUFFIX,zijieapi.com,PROXY
DOMAIN-SUFFIX,byteoversea.com,PROXY
DOMAIN-SUFFIX,aweme.com,PROXY
DOMAIN-SUFFIX,amemv.com,PROXY
DOMAIN,sso.douyin.com,PROXY
DOMAIN,api-douyin.com,PROXY
DOMAIN-KEYWORD,aweme-user,PROXY
DOMAIN-KEYWORD,aweme-comment,PROXY
DOMAIN-KEYWORD,aweme-publish,PROXY
DOMAIN-KEYWORD,aweme-upload,PROXY
DOMAIN-KEYWORD,byteupload,PROXY
FINAL,DIRECT
